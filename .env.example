# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
ADMIN_ID=

# Optional server defaults
DEFAULT_SERVER=IND
DEFAULT_CONCURRENCY=10

# --- Hosting (Railway / Render / Koyeb / Docker) ---
# The guest file is git-ignored, so a hosted deploy has no guest data unless you
# provide it here. Paste the full JSON array from
# guests_manager/guests_converted.json as a single line:
# GUESTS_JSON=[{"uid":"123","password":"abc"}]
GUESTS_JSON=

# Optional: writable directory (mounted volume) for guest/usage files.
# DATA_DIR=/data
# GUESTS_FILE=/data/guests_converted.json
# USAGE_FILE=/data/guest_usage_by_target.json

# Optional: set by web-service hosts. When present the bot opens a health-check
# port so the platform does not mark the deploy as unhealthy.
# PORT=8080
